{
  "manifest_version": 3,
  "name": "DevWebAudit — Speed, Security & Responsive Suite",
  "version": "2.0.2",
  "description": "Audit Lighthouse speed (Desktop+Mobile), 6-layer website security, and live multi-device responsive layouts in one click.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "downloads",
    "clipboardWrite",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://localhost:9876/*",
    "http://127.0.0.1:9876/*",
    "https://www.googleapis.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DevWebAudit - Speed & Security Auditor",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
